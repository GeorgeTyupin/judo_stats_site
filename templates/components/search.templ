	<div class="results-wrapper">
		<div class="results-header">
			Найдено: <span class="results-count">{ fmt.Sprintf("%d", len(clubs)) }</span>
		</div>
		<div class="sort-bar">
			<span class="sort-bar-label">Сортировка:</span>
			<button class="sort-bar-btn" data-sort-col="name" data-sort-dir={ nextDir("name", sortBy, sortDir) }>
				Название
				@sortArrow("name", sortBy, sortDir)
			</button>
		</div>
		<div class="table-scroll">
			<table class="results-table">
				<thead>
					<tr>
						<th class="col-num">#</th>
						<th>Название</th>
						<th>Полное название</th>
						<th>Республика</th>
						<th>Город</th>
					</tr>
				</thead>
				<tbody>
					for i, club := range clubs {
						<tr
							class="result-row"
							data-href={ fmt.Sprintf("/sportclub/%d", club.ID) }
							style={ fmt.Sprintf("animation-delay:%dms", i*20) }
						>
							<td class="col-num">{ fmt.Sprintf("%d", i+1) }</td>
							<td class="col-name">{ club.Name }</td>
							<td>{ club.FullName }</td>
