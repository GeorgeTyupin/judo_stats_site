package components

import (
	"fmt"
	"judo_stats_site/internal/api/handlers/dto"
)

// EmptySearchResults отображает сообщение об отсутствии результатов
templ EmptySearchResults() {
	<div class="empty-search-results">
		<div class="empty-search-icon">
			<i data-lucide="search-x" class="empty-icon"></i>
		</div>
		<h3 class="empty-search-title">Ничего не найдено</h3>
		<p class="empty-search-text">Попробуйте изменить параметры поиска или использовать другие ключевые слова</p>
		<div class="empty-search-suggestions">
			<p class="suggestions-title">Советы для поиска:</p>
			<ul class="suggestions-list">
				<li>Проверьте правильность написания</li>
				<li>Используйте более общие термины</li>
				<li>Попробуйте другую категорию поиска</li>
			</ul>
		</div>
	</div>
}

// JudokaSearchResults отображает результаты поиска дзюдоистов в виде таблицы
templ JudokaSearchResults(judokas []dto.JudokaResponse, sortBy, sortDir string) {
	<div class="results-wrapper">
		<div class="results-header">
			Найдено: <span class="results-count">{ fmt.Sprintf("%d", len(judokas)) }</span>
		</div>
		<div class="sort-bar">
			<span class="sort-bar-label">Сортировка:</span>
			<button class="sort-bar-btn" data-sort-col="name" data-sort-dir={ nextDir("name", sortBy, sortDir) }>
				Имя
				@sortArrow("name", sortBy, sortDir)
			</button>
			<button class="sort-bar-btn" data-sort-col="country" data-sort-dir={ nextDir("country", sortBy, sortDir) }>
				Страна
				@sortArrow("country", sortBy, sortDir)
			</button>
			<button class="sort-bar-btn" data-sort-col="birth_date" data-sort-dir={ nextDir("birth_date", sortBy, sortDir) }>
				Дата рождения
				@sortArrow("birth_date", sortBy, sortDir)
			</button>
		</div>
		<div class="table-scroll">
			<table class="results-table">
				<thead>
					<tr>
						<th class="col-num">#</th>
						<th>Имя</th>
						<th>Страна</th>
						<th>Дата рождения</th>
					</tr>
				</thead>
				<tbody>
					for i, judoka := range judokas {
						<tr
							class="result-row"
							data-href={ fmt.Sprintf("/judoka/%d", judoka.ID) }
							style={ fmt.Sprintf("animation-delay:%dms", i*20) }
						>
							<td class="col-num">{ fmt.Sprintf("%d", i+1) }</td>
							<td class="col-name">
								<div>{ judoka.Name }</div>
								if judoka.City != "" || judoka.SportClub != "" || len(judoka.WeightCategories) > 0 {
									<div class="result-sub">
										if judoka.City != "" {
											<span>{ judoka.City }</span>
										}
										if judoka.SportClub != "" {
											if judoka.City != "" {
												<span class="result-sub-sep">·</span>
											}
											<span>{ judoka.SportClub }</span>
										}
										for _, cat := range judoka.WeightCategories {
											<span class="result-tag">{ cat }</span>
										}
									</div>
								}
							</td>
							<td>{ judoka.Country }</td>
							<td>{ judoka.BirthDate }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

// TournamentSearchResults отображает результаты поиска турниров в виде таблицы
templ TournamentSearchResults(tournaments []dto.TournamentResponse, sortBy, sortDir string) {
	<div class="results-wrapper">
		<div class="results-header">
			Найдено: <span class="results-count">{ fmt.Sprintf("%d", len(tournaments)) }</span>
		</div>
		<div class="sort-bar">
			<span class="sort-bar-label">Сортировка:</span>
			<button class="sort-bar-btn" data-sort-col="name" data-sort-dir={ nextDir("name", sortBy, sortDir) }>
				Название
				@sortArrow("name", sortBy, sortDir)
			</button>
			<button class="sort-bar-btn" data-sort-col="type" data-sort-dir={ nextDir("type", sortBy, sortDir) }>
				Тип
				@sortArrow("type", sortBy, sortDir)
			</button>
			<button class="sort-bar-btn" data-sort-col="place" data-sort-dir={ nextDir("place", sortBy, sortDir) }>
				Место
				@sortArrow("place", sortBy, sortDir)
			</button>
			<button class="sort-bar-btn" data-sort-col="date" data-sort-dir={ nextDir("date", sortBy, sortDir) }>
				Дата
				@sortArrow("date", sortBy, sortDir)
			</button>
		</div>
		<div class="table-scroll">
			<table class="results-table">
				<thead>
					<tr>
						<th class="col-num">#</th>
						<th>Название</th>
						<th class="col-hide-mobile">Тип</th>
						<th class="col-hide-mobile">Место</th>
						<th>Дата</th>
						<th class="col-hide-mobile">Пол</th>
					</tr>
				</thead>
				<tbody>
					for i, t := range tournaments {
						<tr
							class="result-row"
							data-href={ fmt.Sprintf("/tournament/%d", t.ID) }
							style={ fmt.Sprintf("animation-delay:%dms", i*20) }
						>
							<td class="col-num">{ fmt.Sprintf("%d", i+1) }</td>
							<td class="col-name">{ t.Name }</td>
							<td class="col-hide-mobile">{ t.Type }</td>
							<td class="col-hide-mobile">{ t.Place }</td>
							<td>{ t.Date }</td>
							<td class="col-hide-mobile">{ t.Gender }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

// SportClubSearchResults отображает результаты поиска спортивных обществ в виде таблицы
