// CitySearchResults отображает результаты поиска городов в виде таблицы
templ CitySearchResults(cities []dto.CityResponse, sortBy, sortDir string) {
	<div class="results-wrapper">
		<div class="results-header">
			Найдено: <span class="results-count">{ fmt.Sprintf("%d", len(cities)) }</span>
		</div>
		<div class="sort-bar">
			<span class="sort-bar-label">Сортировка:</span>
			<button class="sort-bar-btn" data-sort-col="name" data-sort-dir={ nextDir("name", sortBy, sortDir) }>
				Название
				@sortArrow("name", sortBy, sortDir)
			</button>
		</div>
		<div class="table-scroll">
			<table class="results-table">
				<thead>
					<tr>
						<th class="col-num">#</th>
						<th>Название</th>
						<th>Описание</th>
					</tr>
				</thead>
				<tbody>
					for i, city := range cities {
						<tr
							class="result-row"
							data-href={ fmt.Sprintf("/city/%d", city.ID) }
							style={ fmt.Sprintf("animation-delay:%dms", i*20) }
						>
							<td class="col-num">{ fmt.Sprintf("%d", i+1) }</td>
							<td class="col-name">{ city.Name }</td>
							<td>{ city.Description }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

// sortArrow рендерит иконку стрелки сортировки для sort-bar кнопок
templ sortArrow(col, currentSortBy, currentSortDir string) {
	if col == currentSortBy {
		if currentSortDir == "desc" {
			<i data-lucide="arrow-down" class="sort-arrow sort-arrow-active"></i>
		} else {
			<i data-lucide="arrow-up" class="sort-arrow sort-arrow-active"></i>
		}
	} else {
		<i data-lucide="arrow-up-down" class="sort-arrow"></i>
	}
}

// nextDir возвращает следующее направление сортировки
func nextDir(col, currentSortBy, currentSortDir string) string {
	if col == currentSortBy && currentSortDir == "asc" {
		return "desc"
	}
	return "asc"
}
