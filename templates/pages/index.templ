package pages

import "judo_stats_site/templates/layouts"

templ Index() {
	@layouts.BaseWithJS("Главная", []string{"index.js"}, "index.css") {
		<!-- Hero Section -->
		<section class="hero">
			<div class="container">
				<h1>История отечественного дзюдо</h1>
				<p>Уникальная база данных дзюдоистов, школ и результатов турниров</p>
			</div>
		</section>

		<!-- Search CTA -->
		<section class="search-cta-section">
			<div class="container">
				<div class="search-cta-card">
					<i data-lucide="search" class="search-cta-icon"></i>
					<div class="search-cta-text">
						<span class="search-cta-title">Найдите дзюдоиста, турнир или спортивное общество</span>
						<span class="search-cta-sub">Поиск по всей базе архива</span>
					</div>
					<a href="/search" class="search-cta-btn">
						Перейти к поиску
						<i data-lucide="arrow-right" class="icon-sm"></i>
					</a>
				</div>
			</div>
		</section>

		<!-- Разделы архива -->
		<section class="sections-nav">
			<div class="container">
				<h2 class="section-title">Разделы архива</h2>
				<div class="sections-grid">
					<a href="/search?category=judoka" class="section-card">
						<div class="section-card-icon">
							<i data-lucide="users" class="section-icon-size"></i>
						</div>
						<div class="section-card-body">
							<h3>Дзюдоисты</h3>
							<p>Профили спортсменов с биографией, результатами и весовыми категориями</p>
						</div>
						<i data-lucide="arrow-right" class="section-card-arrow"></i>
					</a>

					<a href="/search?category=tournament" class="section-card">
						<div class="section-card-icon">
							<i data-lucide="trophy" class="section-icon-size"></i>
						</div>
						<div class="section-card-body">
							<h3>Турниры</h3>
							<p>Чемпионаты, первенства и открытые соревнования советской эпохи</p>
						</div>
						<i data-lucide="arrow-right" class="section-card-arrow"></i>
					</a>

					<a href="/search?category=sportclub" class="section-card">
						<div class="section-card-icon">
							<i data-lucide="building" class="section-icon-size"></i>
						</div>
						<div class="section-card-body">
							<h3>Спортивные общества</h3>
							<p>Клубы и секции дзюдо по всему Советскому Союзу</p>
						</div>
						<i data-lucide="arrow-right" class="section-card-arrow"></i>
					</a>

					<a href="/search?category=city" class="section-card">
						<div class="section-card-icon">
							<i data-lucide="map-pin" class="section-icon-size"></i>
						</div>
						<div class="section-card-body">
							<h3>Города</h3>
							<p>География советского дзюдо — от Москвы до Владивостока</p>
						</div>
						<i data-lucide="arrow-right" class="section-card-arrow"></i>
					</a>
				</div>
			</div>
		</section>

		<!-- Stats Section -->
		<section class="stats">
			<div class="container">
				<h2 class="section-title">Статистика архива</h2>
				<div class="stats-grid">
					<div class="stat-card">
						<div class="stat-icon">
							<i data-lucide="users" class="stat-icon-size stat-icon-color"></i>
						</div>
						<div class="stat-number">15,847</div>
						<div class="stat-label">Дзюдоистов</div>
					</div>

					<div class="stat-card">
						<div class="stat-icon">
							<i data-lucide="trophy" class="stat-icon-size stat-icon-color"></i>
						</div>
						<div class="stat-number">3,426</div>
						<div class="stat-label">Турниров</div>
					</div>

					<div class="stat-card">
						<div class="stat-icon">
							<i data-lucide="globe" class="stat-icon-size stat-icon-color"></i>
						</div>
						<div class="stat-number">142</div>
						<div class="stat-label">Страны</div>
					</div>

					<div class="stat-card">
						<div class="stat-icon">
							<i data-lucide="bar-chart" class="stat-icon-size stat-icon-color"></i>
						</div>
						<div class="stat-number">89,234</div>
						<div class="stat-label">Результатов</div>
					</div>

					<div class="stat-card">
						<div class="stat-icon">
							<i data-lucide="globe-2" class="stat-icon-size stat-icon-color"></i>
						</div>
						<div class="stat-number">15</div>
						<div class="stat-label">Республик СССР</div>
					</div>
				</div>

				<!-- Contribution Notice -->
				<div class="index-contribution-notice">
					<p>
						<i data-lucide="lightbulb" class="icon-bulb"></i>
						<span>
							<strong>Помогите развивать архив!</strong> Если вы обнаружили ошибку или располагаете ценной информацией — поделитесь ею с нами.
							<a href="/contribute">Отправить информацию →</a>
						</span>
					</p>
				</div>
			</div>
		</section>

		<!-- Features Section -->
		<section class="features">
			<div class="container">
				<h2 class="section-title">Возможности архива</h2>
				<div class="features-grid features-grid-5">
					<div class="feature-card">
						<div class="feature-icon">
							<i data-lucide="search" class="feature-icon-size"></i>
						</div>
						<h3>Расширенный поиск</h3>
						<p>Поиск по дзюдоистам, турнирам, обществам и городам с многоуровневой фильтрацией</p>
					</div>

					<div class="feature-card">
						<div class="feature-icon">
							<i data-lucide="award" class="feature-icon-size"></i>
						</div>
						<h3>История турниров</h3>
						<p>Архив всех значимых соревнований с результатами, составами и подробной информацией</p>
					</div>

					<div class="feature-card">
						<div class="feature-icon">
							<i data-lucide="user-circle" class="feature-icon-size"></i>
						</div>
						<h3>Профили дзюдоистов</h3>
						<p>Подробные карточки спортсменов с биографией, достижениями и карьерной статистикой</p>
					</div>

					<div class="feature-card">
						<div class="feature-icon">
							<i data-lucide="map-pin" class="feature-icon-size"></i>
						</div>
						<h3>География дзюдо</h3>
						<p>Спортивные общества, тренеры и секции дзюдо по республикам и городам СССР</p>
					</div>

					<div class="feature-card">
						<div class="feature-icon">
							<i data-lucide="zap" class="feature-icon-size"></i>
						</div>
						<h3>Пополнение базы</h3>
						<p>Возможность добавить данные и исправить неточности — архив живёт вместе с сообществом</p>
					</div>
				</div>
			</div>
		</section>

		<!-- History Block -->
		<section class="history-block">
			<div class="container">
				<div class="history-content">
					<div class="history-text">
						<h2>История советского дзюдо</h2>
						<p>
							Дзюдо в СССР прошло путь от экзотической японской борьбы до олимпийской дисциплины, в которой советские спортсмены завоевали признание всего мира.
							Этот архив хранит записи о тысячах турниров, спортсменов и тренеров, вписавших свои имена в историю отечественного дзюдо.
						</p>
						<a href="/history" class="btn-outline">
							Узнать больше
							<i data-lucide="arrow-right" class="icon-sm"></i>
						</a>
					</div>
					<div class="history-decoration">
						<i data-lucide="medal" class="history-icon"></i>
					</div>
				</div>
			</div>
		</section>
	}
}

// IndexAllFilters отображает минимальные фильтры для общего поиска
templ IndexAllFilters() {
	<div class="filters">
		<input type="hidden" name="category" value="all"/>
		<div class="all-search-hint">
			<p>Введите запрос для поиска по всем категориям: дзюдоистам, турнирам, спортивным обществам и городам</p>
		</div>
	</div>
}

// IndexJudokaFilters отображает фильтры для дзюдоистов
templ IndexJudokaFilters() {
	<div class="filters">
		<input type="hidden" name="category" value="judoka"/>

		<div class="filter-group filter-group-full">
			<label>Весовая категория</label>
			<div class="weight-toggle-group">
				for _, cat := range []struct{ val, label string }{
					{"-48", "-48 кг"},
					{"-52", "-52 кг"},
					{"-57", "-57 кг"},
					{"-60", "-60 кг"},
					{"-63", "-63 кг"},
					{"-66", "-66 кг"},
					{"-70", "-70 кг"},
					{"-73", "-73 кг"},
					{"-78", "-78 кг"},
					{"-81", "-81 кг"},
					{"+78", "+78 кг"},
					{"-90", "-90 кг"},
					{"-100", "-100 кг"},
					{"+100", "+100 кг"},
				} {
					<label class="weight-toggle">
						<input
							type="checkbox"
							name="filter_weight"
							value={ cat.val }
							hx-get="/search/results"
							hx-trigger="change"
							hx-target="#search-results"
							hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
						/>
						<span>{ cat.label }</span>
					</label>
				}
			</div>
		</div>

		<div class="filter-group">
			<label>Пол</label>
			<select
				name="filter_gender"
				hx-get="/search/results"
				hx-trigger="change"
				hx-target="#search-results"
				hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
			>
				<option value="">Все</option>
				<option value="male">Мужской</option>
				<option value="female">Женский</option>
			</select>
		</div>

		<div class="filter-group">
			<label>Год рождения</label>
			<input
				type="number"
				name="filter_birth_year"
				placeholder="1960"
				min="1920"
				max="1985"
				hx-get="/search/results"
				hx-trigger="keyup changed delay:500ms"
				hx-target="#search-results"
				hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
			/>
		</div>

		<div class="filter-group">
			<label>Страна</label>
			<div class="autocomplete-wrapper">
				<input
					type="text"
					name="filter_country"
					placeholder="Введите страну..."
					class="autocomplete-input"
					autocomplete="off"
					hx-get="/search/results"
					hx-trigger="keyup changed delay:500ms"
					hx-target="#search-results"
					hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
				/>
				<div class="autocomplete-dropdown" hidden></div>
			</div>
		</div>

		<div class="filter-group">
			<label>Спортивное общество</label>
			<div class="autocomplete-wrapper">
				<input
					type="text"
					name="filter_sportclub"
					placeholder="Введите общество..."
					class="autocomplete-input"
					autocomplete="off"
					hx-get="/search/results"
					hx-trigger="keyup changed delay:500ms"
					hx-target="#search-results"
					hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
				/>
				<div class="autocomplete-dropdown" hidden></div>
			</div>
		</div>

		<div class="filter-group">
			<label>Город</label>
			<div class="autocomplete-wrapper">
				<input
					type="text"
					name="filter_city"
					placeholder="Введите город..."
					class="autocomplete-input"
					autocomplete="off"
					hx-get="/search/results"
					hx-trigger="keyup changed delay:500ms"
					hx-target="#search-results"
					hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
				/>
				<div class="autocomplete-dropdown" hidden></div>
			</div>
		</div>
	</div>
}

// IndexTournamentFilters отображает фильтры для турниров
templ IndexTournamentFilters() {
	<div class="filters">
		<input type="hidden" name="category" value="tournament"/>

		<div class="filter-group">
			<label>Тип турнира</label>
			<select
				name="filter_type"
				hx-get="/search/results"
				hx-trigger="change"
				hx-target="#search-results"
				hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
			>
				<option value="">Все</option>
				<option value="National Championships">Чемпионат</option>
				<option value="National Open WC Championships">Открытый чемпионат</option>
				<option value="National Tournament">Первенство</option>
			</select>
		</div>

		<div class="filter-group">
			<label>Год</label>
			<input
				type="number"
				name="filter_year"
				placeholder="например, 1980"
				min="1960"
				max="1992"
				hx-get="/search/results"
				hx-trigger="keyup changed delay:500ms"
				hx-target="#search-results"
				hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
			/>
		</div>

		<div class="filter-group">
			<label>Месяц</label>
			<select
				name="filter_month"
				hx-get="/search/results"
				hx-trigger="change"
				hx-target="#search-results"
				hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
			>
				<option value="">Все</option>
				<option value="1">Январь</option>
				<option value="2">Февраль</option>
				<option value="3">Март</option>
				<option value="4">Апрель</option>
				<option value="5">Май</option>
				<option value="6">Июнь</option>
				<option value="7">Июль</option>
				<option value="8">Август</option>
				<option value="9">Сентябрь</option>
				<option value="10">Октябрь</option>
				<option value="11">Ноябрь</option>
				<option value="12">Декабрь</option>
			</select>
		</div>

		<div class="filter-group">
			<label>Город</label>
			<div class="autocomplete-wrapper">
				<input
					type="text"
					name="filter_city"
					placeholder="Введите город..."
					class="autocomplete-input"
					autocomplete="off"
					hx-get="/search/results"
					hx-trigger="keyup changed delay:500ms"
					hx-target="#search-results"
					hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
				/>
				<div class="autocomplete-dropdown" hidden></div>
			</div>
		</div>

		<div class="filter-group">
			<label>Республика СССР</label>
			<div class="autocomplete-wrapper">
				<input
					type="text"
					name="filter_republic"
					placeholder="Введите республику..."
					class="autocomplete-input"
					autocomplete="off"
					hx-get="/search/results"
					hx-trigger="keyup changed delay:500ms"
					hx-target="#search-results"
					hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
				/>
				<div class="autocomplete-dropdown" hidden></div>
			</div>
		</div>

		<div class="filter-group">
			<label>Страна</label>
			<div class="autocomplete-wrapper">
				<input
					type="text"
					name="filter_country"
					placeholder="Введите страну..."
					class="autocomplete-input"
					autocomplete="off"
					hx-get="/search/results"
					hx-trigger="keyup changed delay:500ms"
					hx-target="#search-results"
					hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
				/>
				<div class="autocomplete-dropdown" hidden></div>
			</div>
		</div>

		<div class="filter-group">
			<label>Пол</label>
			<select
				name="filter_gender"
				hx-get="/search/results"
				hx-trigger="change"
				hx-target="#search-results"
				hx-include="[name='query'], [name='category'], [name^='filter_'], [name='sort_by'], [name='sort_dir']"
			>
				<option value="">Все</option>
				<option value="Men">Мужчины</option>
				<option value="Women">Женщины</option>
			</select>
		</div>

	</div>
}

