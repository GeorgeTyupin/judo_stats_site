package layouts

templ Base(title string, pageCSS ...string) {
	@BaseWithJS(title, nil, pageCSS...)
}

templ BaseWithJS(title string, pageJS []string, pageCSS ...string) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Архив дзюдо</title>
			<link rel="icon" type="image/svg+xml" href="/static/img/logo/favicon.svg"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/img/logo/favicon.svg"/>
			<meta name="theme-color" content="#0D9488"/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
			for _, css := range pageCSS {
				<link rel="stylesheet" href={ templ.URL("/static/css/" + css) }/>
			}
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			<script src="https://unpkg.com/lucide@latest"></script>
		</head>
		<body>
			@Header()
			<main>
				{ children... }
			</main>
			@Footer()
			if pageJS != nil {
				for _, js := range pageJS {
					<script src={ templ.URL("/static/js/" + js) }></script>
				}
			}
			<script>
				lucide.createIcons();
				document.body.addEventListener('htmx:afterSwap', function() {
					lucide.createIcons();
				});
			</script>
		</body>
	</html>
}

templ Header() {
	<header>
		<div class="header-top">
			<div class="container">
				<div class="header-top-contacts">
					<span class="flex-align-center"><i data-lucide="mail" class="icon-sm"></i> info@judoarchive.com</span>
				</div>
				<div>
					<a href="/contribute">Добавить информацию</a>
					<a href="/contribute">Обратная связь</a>
				</div>
			</div>
		</div>
		<div class="header-main">
			<div class="container">
				<div class="header-content">
					<a href="/" class="logo flex-align-center-gap-10">
						<div class="logo-image-wrapper">
							<img src="/static/img/logo/logo-light.svg" alt="Архив дзюдо" class="logo-image"/>
						</div>
						<div class="logo-text-group">
							<span class="logo-text">Архив дзюдо</span>
							<span class="logo-tagline">История отечественного дзюдо</span>
						</div>
					</a>
					<nav>
						<ul>
							<li><a href="/">Главная</a></li>
							<li><a href="/search">Поиск</a></li>
							<li><a href="/search?category=judoka">Дзюдоисты</a></li>
							<li><a href="/search?category=tournament">Турниры</a></li>
							<li><a href="/contribute">Добавить данные</a></li>
							<li><a href="/about">О проекте</a></li>
						</ul>
					</nav>
				</div>
			</div>
		</div>
	</header>
}

templ Footer() {
	<footer>
		<div class="container">
			<div class="footer-top">
				<a href="/" class="footer-logo flex-align-center-gap-10">
					<img src="/static/img/logo/logo-light.svg" alt="Архив дзюдо" class="footer-logo-image"/>
					<div class="logo-text-group">
						<span class="footer-logo-text">Архив дзюдо</span>
						<span class="footer-logo-tagline">История отечественного дзюдо</span>
					</div>
				</a>
			</div>
			<div class="footer-grid">
				<div class="footer-section">
					<h3>Навигация</h3>
					<ul class="footer-links">
						<li><a href="/search">Поиск</a></li>
						<li><a href="/search?category=judoka">Дзюдоисты</a></li>
						<li><a href="/search?category=tournament">Турниры</a></li>
						<li><a href="/history">Славные моменты истории</a></li>
					</ul>
				</div>
				<div class="footer-section">
					<h3>Информация</h3>
					<ul class="footer-links">
						<li><a href="/ussr-competitions">Система соревнований СССР</a></li>
						<li><a href="/dynasties">Династии</a></li>
						<li><a href="/referees">Судьи</a></li>
						<li><a href="/namesakes">Именники</a></li>
					</ul>
				</div>
				<div class="footer-section">
					<h3>Помощь</h3>
					<ul class="footer-links">
						<li><a href="/support">Помощь проекту</a></li>
						<li><a href="/contribute">Добавить информацию</a></li>
						<li><a href="/feedback">Обратная связь</a></li>
						<li><a href="/contacts">Контакты</a></li>
					</ul>
				</div>
				<div class="footer-section">
					<h3>О проекте</h3>
					<p class="footer-description">
						История отечественного дзюдо — архив дзюдоистов, турниров и результатов советской эпохи.
					</p>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; 2026 Архив дзюдо. Все права защищены.</p>
			</div>
		</div>
	</footer>
}
